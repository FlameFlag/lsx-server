# Copy to config/local.env and adjust for your VM.
# The local runner sources this file as a POSIX shell script.

LEMONADE2_VM_SSH=admin@192.168.88.22
LEMONADE2_REMOTE_ROOT='C:/Users/Admin/AppData/Local/Temp/lemonade2_static_unpacking'
LEMONADE2_GAME_EXE='C:/Program Files (x86)/Lemonade Tycoon 2 - New York City/Lemonade2.exe'
LEMONADE2_RUN_SECONDS=20
LEMONADE2_DUMP_MEMORY=0

# Optional. If set and sshpass is installed, scripts/run_vm_capture.sh uses it.
# Prefer SSH keys when available.
# LEMONADE2_VM_PASSWORD=''
