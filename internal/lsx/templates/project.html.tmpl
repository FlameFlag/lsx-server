<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{.Title}}</title>
  <style>{{.CSS}}</style>
</head>

<body>
  <main class="screen">
    <header class="top-panel" aria-label="Lemonade Tycoon 2">
      <img class="brand-panel" src="/project/asset/lt2_logo_text_only.avif"
        alt="Lemonade Tycoon 2 New York Edition">
      <nav class="main-menu" aria-label="Main menu">
        <a class="menu-tab" href="/">
          <span class="menu-label">Play</span>
          <span class="menu-orb icon-play" aria-hidden="true">
            <span class="nav-icon nav-play"></span>
          </span>
        </a>
        <a class="menu-tab{{if .BoardActive}} active{{end}}" href="/board"{{if .BoardActive}} aria-current="page"{{end}}>
          <span class="menu-label">LSX</span>
          <span class="menu-orb icon-lsx" aria-hidden="true">
            <span class="nav-icon nav-lsx"></span>
          </span>
        </a>
        <a class="menu-tab{{if .HelpActive}} active{{end}}" href="/findings"{{if .HelpActive}} aria-current="page"{{end}}>
          <span class="menu-label">Findings</span>
          <span class="menu-orb icon-findings" aria-hidden="true">
            <span class="nav-icon nav-findings"></span>
          </span>
        </a>
        <a class="menu-tab{{if .DocsActive}} active{{end}}" href="/docs"{{if .DocsActive}} aria-current="page"{{end}}>
          <span class="menu-label">Docs</span>
          <span class="menu-orb icon-docs" aria-hidden="true">
            <span class="nav-icon nav-docs"></span>
          </span>
        </a>
      </nav>
    </header>

    <section class="game-window">
      <h1>{{.Heading}}</h1>
      <div class="content-panel lsx-home-panel">
        <div class="menu-card lsx-card">
          <div class="lsx-console">
            <section class="lsx-board-preview" aria-label="Lemonade Stock Exchange preview">
              <div class="lsx-preview-head">
                <img src="/project/asset/lt2_icon_lsx.avif" alt="" aria-hidden="true">
                <div>
                  <p class="lsx-kicker">Market Open</p>
                  <h2>Lemonade Stock Exchange</h2>
                </div>
              </div>
              <div class="lsx-ticker">
                <span>{{if .BoardTotal}}{{.BoardTotal}} LSX submission{{if ne .BoardTotal 1}}s{{end}} currently ranked.{{else}}No LSX submissions have been received yet.{{end}}</span>
              </div>
              <div class="lsx-table-preview">
                <div><span>Rank</span><span>Company</span><span>Market Cap</span></div>
                {{if .BoardRows}}{{range .BoardRows}}<div><span>{{.Rank}}</span><span>{{.Company}}</span><span>${{.MarketCap}}</span></div>{{end}}{{else}}<div class="empty"><span>-</span><span>No submissions</span><span>$0.00</span></div>{{end}}
              </div>
            </section>

            <aside class="lsx-side-panel">
              <a class="game-button" href="/board">
                <span>Open LSX Board</span>
                <img class="button-mascot" src="/project/asset/lt2_icon_lsx.avif" alt="" aria-hidden="true">
              </a>

              <div class="lsx-sort-card">
                <h2>Sort Board</h2>
                <div class="lsx-sort-grid">
                  <a href="/board?sort=0">Rank</a>
                  <a href="/board?sort=1">Company</a>
                  <a href="/board?sort=3">Lifespan</a>
                  <a href="/board?sort=4">Market Cap</a>
                </div>
              </div>
            </aside>
          </div>

          <div class="credits" id="credits">
            <div class="credits-badge">
              <img class="credits-mascot" src="/project/asset/lt2_asset_credits.avif" alt="" aria-hidden="true">
              <span>Credits</span>
            </div>
            <div class="credits-copy">
              <a class="credit-person" href="https://github.com/FlameFlag">
                <img class="credit-avatar credit-avatar-flameflag" src="/project/asset/flameflag_lemon.png" alt="" aria-hidden="true">
                <span class="credit-detail">
                  <span class="credit-role">Revival</span>
                  <span class="credit-name">FlameFlag</span>
                </span>
              </a>
              <a class="credit-person" href="https://github.com/TiZmSpectrum">
                <img class="credit-avatar credit-avatar-timz" src="/project/asset/timz_lemon.png" alt="" aria-hidden="true">
                <span class="credit-detail">
                  <span class="credit-role">Idea &amp; Domain</span>
                  <span class="credit-name">TiZmSpectrum</span>
                </span>
              </a>
            </div>
            <a class="credits-github-link" href="https://github.com/FlameFlag/lsx-server" aria-label="Source code on GitHub">
              <img class="credits-github" src="/project/asset/lt2_asset_github.avif" alt="" aria-hidden="true">
              <span>Source</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</body>

</html>
