<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>LSX Admin Login</title>
  <link rel="stylesheet" href="{{.AdminPath}}/asset/login.css">
</head>

<body>
  <main class="login-shell">
    <img class="login-logo" src="/project/asset/lt2_logo_text_only.avif"
      alt="Lemonade Tycoon 2 New York Edition">
    <form class="box" method="post">
    <div class="brand">
      <div>
        <h1>Lemonade Stock Exchange</h1>
        <p>Protected admin console</p>
      </div>
    </div>
    {{if .Error}}<div class="err">{{.Error}}</div>{{end}}
    <div class="fields">
      <label>Username</label>
      <input name="username" autocomplete="username">
      <label>Password</label>
      <input name="password" type="password" autocomplete="current-password">
    </div>
    <button class="login-button">Log in</button>
    </form>
  </main>
</body>

</html>
