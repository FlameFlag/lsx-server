<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{.Title}}</title>
  <style>{{.CSS}}</style>
  <script type="module" src="/project/asset/docs/entry.js"></script>
</head>

<body class="docs-page">
  <main class="screen">
    <header class="top-panel" aria-label="Lemonade Tycoon 2">
      <img class="brand-panel" src="/project/asset/lt2_logo_text_only.avif"
        alt="Lemonade Tycoon 2 New York Edition">
      <nav class="main-menu" aria-label="Main menu">
        <a class="menu-tab" href="/">
          <span class="menu-label">Play</span>
          <span class="menu-orb icon-play" aria-hidden="true">
            <span class="nav-icon nav-play"></span>
          </span>
        </a>
        <a class="menu-tab" href="/board">
          <span class="menu-label">LSX</span>
          <span class="menu-orb icon-lsx" aria-hidden="true">
            <span class="nav-icon nav-lsx"></span>
          </span>
        </a>
        <a class="menu-tab" href="/findings">
          <span class="menu-label">Findings</span>
          <span class="menu-orb icon-findings" aria-hidden="true">
            <span class="nav-icon nav-findings"></span>
          </span>
        </a>
        <a class="menu-tab active" href="/docs" aria-current="page">
          <span class="menu-label">Docs</span>
          <span class="menu-orb icon-docs" aria-hidden="true">
            <span class="nav-icon nav-docs"></span>
          </span>
        </a>
      </nav>
    </header>

    <section class="game-window">
      <h1>{{.Heading}}</h1>
      <div class="content-panel docs-panel">
        <article class="docs-root" aria-labelledby="docs-title">
          <header class="docs-hero">
            <div>
              <p class="docs-kicker">OpenAPI</p>
              <h2 id="docs-title">LSX Server API</h2>
              <p class="docs-intro">Live leaderboard endpoints generated from the OpenAPI contract.</p>
            </div>
            <div class="docs-actions" aria-label="API resources">
              <a href="/openapi.yaml">OpenAPI YAML</a>
              <a href="/api/v1/leaderboard">Sample JSON</a>
            </div>
          </header>
          <div id="openapi-docs-root" class="openapi-docs-root" data-openapi-url="/openapi.yaml" aria-live="polite">
            <p class="docs-loading">Loading API documentation...</p>
          </div>
        </article>
      </div>
    </section>
  </main>
</body>

</html>
