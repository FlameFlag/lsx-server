LSX_VERSION=prod

# Port 80 is the default for the recovered game client.
# Set this only for local testing, for example LSX_HTTP_PORT=8080.
# LSX_HTTP_PORT=80

# Runtime server options. For Docker, LSX_HTTP_PORT controls the host port
# mapping while LSX_ADDR should usually stay :80 inside the container.
# LSX_ADDR=:80
# LSX_DATA=/app/data/lsx.sqlite3
LSX_SEED=false
LSX_STRICT_CHECKSUM=false
LSX_PLAIN=true

# Leave these empty to keep the admin console disabled.
LSX_ADMIN_USER=
LSX_ADMIN_PASSWORD=
LSX_ADMIN_PATH=

# Discord alerting is disabled when LSX_DISCORD_WEBHOOK is empty.
LSX_DISCORD_WEBHOOK=
LSX_DISCORD_EVENTS=sync,sync_rejected,sync_error,account,account_error
LSX_DISCORD_ICON=embedded
LSX_DISCORD_TIMEOUT=5s
