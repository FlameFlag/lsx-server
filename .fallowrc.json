{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": ["web/src/main.ts"],
  "workspaces": {
    "patterns": ["web"]
  },
  "ignorePatterns": ["assets/**/*.css", "assets/project/svelte/**", "web/node_modules/**", "web/static/legacy/*.css"],
  "dynamicallyLoaded": ["web/svelte.config.js"],
  "ignoreExportsUsedInFile": true,
  "ignoreExports": [
    { "file": "web/src/App.svelte", "exports": ["*"] },
    { "file": "web/src/components/AdminDashboard.svelte", "exports": ["*"] },
    { "file": "web/src/components/AdminLogin.svelte", "exports": ["*"] },
    { "file": "web/src/components/DocsPage.svelte", "exports": ["*"] },
    { "file": "web/src/components/FindingsPage.svelte", "exports": ["*"] },
    { "file": "web/src/components/HomePage.svelte", "exports": ["*"] }
  ],
  "rules": {
    "unused-files": "warn",
    "unused-exports": "warn",
    "unused-types": "warn"
  }
}
