{
  "name": "lsx-server-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--no-deprecation vite --host 127.0.0.1",
    "build": "NODE_OPTIONS=--no-deprecation vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "generate:openapi": "openapi-typescript ../openapi.yaml -o src/openapi-types.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.2.10",
    "@fontsource/roboto-condensed": "^5.2.8",
    "@humanspeak/svelte-markdown": "^1.5.3",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "buffer": "^6.0.3",
    "highlight.js": "^11.11.1",
    "openapi-fetch": "^0.17.0",
    "slugify": "^1.6.9",
    "svelte": "^5.55.10",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.14"
  },
  "devDependencies": {
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^25.9.1",
    "openapi-typescript": "^7.13.0",
    "svelte-check": "^4.4.8",
    "typescript": "^5.9.3"
  }
}
